# Build context allowlist: send the daemon only what the Dockerfile copies.
# Everything else (certs/, .env, go.work, node_modules/, bin/) stays out, so no
# key or secret can reach a layer and the context stays small.
*
!go.mod
!go.sum
!cmd/
!internal/
!config.development.yaml

# Tests never enter the binary.
**/*_test.go
