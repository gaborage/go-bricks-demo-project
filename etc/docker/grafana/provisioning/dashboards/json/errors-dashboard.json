        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{http_route}} - {{http_response_status_code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Error Rate by Endpoint",
      "type": "timeseries"
